# Core app and auth
# Supabase public client config - safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_or_publishable_key_here

# Server-side Supabase access - never expose these with a NEXT_PUBLIC_ prefix.
# SUPABASE_URL is optional when it matches NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI providers
# Required for script generation, script improvement, niche analysis,
# and the main roast analysis orchestration/fallback transcription.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required for frame-by-frame visual analysis in the roast pipeline.
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# Audio transcription provider chain for roast analysis.
# Set at least one. AssemblyAI is preferred, OpenAI Whisper is next,
# and Anthropic is used as the final fallback when available.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional product switches
STRIPE_SECRET_KEY=your_stripe_secret_key_here
BYPASS_PASSWORD=set_a_long_random_password_here
CRON_SECRET=set_a_long_random_cron_secret_here
NEXT_PUBLIC_SLOTS_REMAINING=47
HOOK_EXTENSION_THRESHOLD=68
HOOK_FULL_VIDEO_THRESHOLD=82

# Native runtime dependencies (install outside .env)
# - ffmpeg
# - ffprobe
# - yt-dlp (only required for scripts/analyze_tiktok.py, not for the shipped web app)
